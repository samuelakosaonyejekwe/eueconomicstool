#!/bin/sh
# Runs automatically on every `git push`. When the main branch is going to
# GitHub, it switches the site builder on for this push and starts a background
# job that tidies up afterwards, so a plain `git push` publishes the site and
# leaves no build or deployment records behind.
case "$2" in *github.com*) ;; *) exit 0 ;; esac
SHA=""
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ "$REMOTE_REF" = "refs/heads/main" ] && SHA="$LOCAL_SHA"
done
[ -n "$SHA" ] || exit 0
command -v gh >/dev/null 2>&1 || { echo "note: GitHub CLI not found; the site will not rebuild."; exit 0; }
REPO=$(echo "$2" | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')
ROOT=$(git rev-parse --show-toplevel)
gh api -X PUT "repos/$REPO/actions/permissions" -F enabled=true >/dev/null 2>&1 || echo "note: could not switch the site builder on."
nohup sh "$ROOT/tools/after-push.sh" "$REPO" "$SHA" >"$ROOT/.git/after-push.log" 2>&1 &
echo "Site update started; it will be live in about a minute."
exit 0
